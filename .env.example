NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Privy (dashboard.privy.io): enable Google (and email) login and Solana embedded wallets.
# Without an app id the app runs in demo mode with sign-in disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Browser-safe RPC for wallet balances and signing (e.g. Helius with an allowed-domains key).
NEXT_PUBLIC_SOLANA_RPC_URL=
